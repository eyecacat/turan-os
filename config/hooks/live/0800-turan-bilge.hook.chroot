#!/bin/sh
set -e

# API anahtarini koru

# Bilge masaustu kisayollari
mkdir -p /etc/skel/Desktop
cat > /etc/skel/Desktop/bilge-sohbet.desktop <<'EOT'
[Desktop Entry]
Type=Application
Name=Bilge AI Sohbet
Comment=Çevrimiçi yapay zeka sohbeti (OpenRouter)
Exec=xfce4-terminal -e "bilge-sohbet" --title=Bilge --maximize
Icon=turan-os
Terminal=false
Categories=Utility;
EOT
chmod +x /etc/skel/Desktop/bilge-sohbet.desktop

cat > /etc/skel/Desktop/sanyrak.desktop <<'EOT'
[Desktop Entry]
Type=Application
Name=Sanyrak Baslatici
Comment=Dairesel uygulama menusu
Exec=sanyrak
Icon=turan-os
Terminal=false
Categories=Utility;
EOT
chmod +x /etc/skel/Desktop/sanyrak.desktop

# MOTD guncelle
cat > /etc/update-motd.d/00-turan <<'EOT'
#!/bin/sh
SURUM="$(cat /etc/turan-surum 2>/dev/null || echo '?')"
printf '\n\033[1;36m  TURAN-OS\033[0m %s\n' "$SURUM"
printf '  \033[1;33m𐱅𐰇𐰼𐰚 𐰚𐰀𐰏𐰀𐰣𐰞𐰃𐰚\033[0m  -  Bozkir + Bilge\n'
printf '  Bilge AI  : \033[1mbilge yardim\033[0m\n'
printf '  Sanyrak   : \033[1msanyrak\033[0m  (Super+Space)\n'
printf '  Terminal  : \033[1mturan yardim\033[0m\n'
printf '  https://github.com/eyecacat/turan-os\n\n'
EOT
chmod +x /etc/update-motd.d/00-turan

exit 0
