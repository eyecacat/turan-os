#!/bin/sh
set -e

# Derleme ortamindan gelen anahtar (GitHub Actions secret'ten gelir).
# Anahtar yoksa bos sablon yazilir, kullanici kendi anahtarini girer.

mkdir -p /etc/turan

if [ -n "${OPENROUTER_API_KEY:-}" ]; then
  cat > /etc/turan/bilge-ai.conf <<EOT
# TURAN-OS Bilge AI - derleme sirasinda uretildi
BILGE_API_KEY="${OPENROUTER_API_KEY}"
BILGE_MODEL="nvidia/nemotron-3.5-super-vl:free"
BILGE_FALLBACK="cohere/north-mini-code:free"
BILGE_URL="https://openrouter.ai/api/v1/chat/completions"
BILGE_MAX_TOKENS="800"
BILGE_ZAMAN_ASIMI="45"
EOT
  chmod 600 /etc/turan/bilge-ai.conf
  chown root:root /etc/turan/bilge-ai.conf
  echo "[bilge] API anahtari gomuldu"
else
  cat > /etc/turan/bilge-ai.conf <<EOT
# TURAN-OS Bilge AI - anahtar gomulmedi
# Kullanim: ~/.config/turan/bilge.conf icine BILGE_API_KEY satiri ekleyin
BILGE_API_KEY=""
BILGE_MODEL="nvidia/nemotron-3.5-super-vl:free"
BILGE_FALLBACK="cohere/north-mini-code:free"
BILGE_URL="https://openrouter.ai/api/v1/chat/completions"
BILGE_MAX_TOKENS="800"
BILGE_ZAMAN_ASIMI="45"
EOT
  chmod 644 /etc/turan/bilge-ai.conf
  echo "[bilge] Anahtar yok, kullanici girecek"
fi

exit 0
