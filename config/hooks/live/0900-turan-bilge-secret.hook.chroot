#!/bin/sh
set -e
# Anahtar ISO'ya GOMULMEZ. Her kullanici kendi anahtarini girer: bilge ayar
mkdir -p /etc/turan
cat > /etc/turan/bilge-ai.conf <<EOT
# TURAN-OS Bilge AI yapilandirmasi (anahtar icermez)
# Kendi anahtariniz icin: bilge ayar
BILGE_API_KEY=""
BILGE_MODEL="nvidia/nemotron-3.5-super-vl:free"
BILGE_FALLBACK="cohere/north-mini-code:free"
BILGE_MODEL2="nvidia/nemotron-3.5-lightning:free"
BILGE_URL="https://openrouter.ai/api/v1/chat/completions"
BILGE_MAX_TOKENS="800"
BILGE_ZAMAN_ASIMI="45"
EOT
chmod 644 /etc/turan/bilge-ai.conf
exit 0
